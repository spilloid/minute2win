#!ipxe
# Boots the minute2win WinPE STATICALLY: every boot that reaches this script deploys (and wipes). Use it only behind a per-boot
# opt-in, such as kvm-it's "press n" autoexec. For dnsmasq/PXE use minute2win-server's /boot/${net0/mac} instead: its arm is
# consumed on boot, so a machine whose firmware network-boots first cannot wipe itself again after the deploy reboots it.
# (bcdboot also puts Windows Boot Manager first in the UEFI order, which normally prevents that loop, but firmware with a
# forced network-first or USB-first policy ignores it.)
# The manifest initrd picks the deployment profile; wimboot places it at X:\Windows\System32\manifest.json.
#
# m2w-base is YOUR boot-asset folder (wimboot, BCD, boot.sdi, boot.wim, minute2win/). There is no default host: set m2w-base
# before chaining this script, or let `tools/stage.sh <outdir> <base>` write it into the staged copy. Unset, it boots nothing.

isset ${m2w-base} || set m2w-base @M2W_BASE@
iseq ${m2w-base} @M2W_BASE@ && goto nobase ||
set base ${m2w-base}
isset ${m2w-manifest} || set m2w-manifest win11-pro

kernel ${base}/wimboot
initrd ${base}/BCD BCD
initrd ${base}/boot.sdi boot.sdi
initrd --name manifest.json ${base}/minute2win/manifests/${m2w-manifest}.json manifest.json
initrd ${base}/boot.wim boot.wim

boot

:nobase
echo minute2win: m2w-base is not set, so there is nothing to boot. Not deploying.
echo Set it to your boot-asset URL before chaining this script (set m2w-base https://<your host>/windows11),
echo or stage the script with: tools/stage.sh <outdir> https://<your host>/windows11
exit 1
